{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow State Schema",
  "description": "工作流执行状态的 JSON Schema",
  "type": "object",
  "required": ["workflow_id", "current_skill", "skills"],
  "properties": {
    "workflow_id": {
      "type": "string",
      "description": "工作流唯一标识",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "工作流创建时间（ISO 8601）"
    },
    "current_skill": {
      "type": "string",
      "description": "当前工作流状态",
      "enum": ["no_active_task", "completed"],
      "pattern": "^(no_active_task|completed|skill\\d+_in_progress)$"
    },
    "skills": {
      "type": "object",
      "description": "技能执行状态映射",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "failed", "skipped"],
            "description": "技能执行状态"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "依赖的上游技能列表"
          },
          "output_path": {
            "type": "string",
            "description": "产出物文件路径"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "description": "开始执行时间"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "完成时间"
          },
          "skipped_at": {
            "type": "string",
            "format": "date-time",
            "description": "跳过时间"
          },
          "skip_reason": {
            "type": "string",
            "description": "跳过原因"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "description": "尝试次数"
          },
          "gate_level": {
            "type": "string",
            "enum": ["strict", "standard", "relaxed"],
            "description": "质量门禁级别"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "description": "工作流上下文数据",
      "properties": {
        "user_preferences": {
          "type": "object",
          "description": "用户偏好设置"
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "用户修正记录"
        }
      }
    }
  }
}
