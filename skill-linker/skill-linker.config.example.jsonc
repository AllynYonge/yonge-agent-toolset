{
  // 模式名称。执行 `skill-linker link dev` 时会读取这里的 dev 配置。
  "modes": {
    "dev": {
      // 需要链接的 SKILL 目录。相对路径以本配置文件所在目录为基准。
      "skills": [
        "../skills/browser",
        "../skills/documents",
      ],

      // 当前模式需要写入各 Agent 平台项目配置的 MCP 服务。
      "mcpServers": {
        "filesystem": {
          // 本地 MCP：通过命令启动子进程。
          "type": "local",
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            ".",
          ],

          // 环境变量按原样写入平台配置，不会在这里展开。
          "env": {
            "NODE_ENV": "development",
            "LOG_LEVEL": "info",
          },
        },

        "context7": {
          // 远程 MCP：通过 Streamable HTTP 地址连接。
          "type": "remote",
          "url": "https://mcp.context7.com/mcp",

          // 请求头按原样写入；建议引用环境变量，不要直接填写密钥。
          "headers": {
            // 这是占位值，使用时替换为目标 MCP 服务要求的认证信息。
            "Authorization": "Bearer YOUR_TOKEN",
            "X-Client-Name": "skill-linker",
          },
        },
      },
    },

    // 只配置 SKILL 的模式可以省略 mcpServers。
    "research": {
      "skills": [
        "../skills/article-analysis",
      ],
    },
  },
}
