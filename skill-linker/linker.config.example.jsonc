{
  // 模式名称。执行 `skill-linker link dev` 时会读取这里的 dev 配置。
  "modes": {
    "dev": {
      // 需要链接的 SKILL 目录。相对路径以本配置文件所在目录为基准。
      "skills": [
        "../skills/browser",
        "../skills/documents",
      ],

      // 当前模式需要写入各 Agent 平台项目配置的 MCP 服务。
      "mcpServers": {
        "filesystem": {
          // 本地 MCP：通过命令启动子进程。
          "type": "local",
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            ".",
          ],

          // 环境变量按原样写入平台配置，不会在这里展开。
          "env": {
            "NODE_ENV": "development",
            "LOG_LEVEL": "info",
          },

          // 可选。等待 MCP 启动的秒数，必须是正整数。
          // Codex 原样写入 startup_timeout_sec；
          // Claude Code 和 agents 平台忽略该字段。
          "startup_timeout_sec": 120,
        },

        "context7": {
          // 远程 MCP：通过 Streamable HTTP 地址连接。
          "type": "remote",
          "url": "https://mcp.context7.com/mcp",

          // 请求头按原样写入；建议引用环境变量，不要直接填写密钥。
          "headers": {
            // 这是占位值，使用时替换为目标 MCP 服务要求的认证信息。
            "Authorization": "Bearer YOUR_TOKEN",
            "X-Client-Name": "skill-linker",
          },

          // 可选。指定预注册的 OAuth 客户端，避免各平台各自动态注册一个新客户端。
          // 各平台字段名不同：Codex 写 client_id；Claude Code 和 agents 平台写 clientId。
          // 仅远程 MCP 可用；OAuth 的登录令牌不写入项目配置，需要各自登录一次。
          "oauth": { "clientId": "your-pre-registered-client-id" },
        },
      },

      // 各平台的基础指令文件。PATH 必须指向文件；相对路径以本配置文件所在目录为基准。
      "baseInstruction": {
        "claude": {
          "PATH": "../CLAUDE.md",
          "NAME": "CLAUDE.md",
        },
        "codex": {
          "PATH": "../AGENTS.md",
          "NAME": "AGENTS.md",
        },
        "agents": {
          "PATH": "../AGENTS.md",
          "NAME": "AGENTS.md",
        },
      },
    },

    // 只配置 SKILL 的模式可以省略 mcpServers 和 baseInstruction。
    "research": {
      "skills": [
        "../skills/article-analysis",
      ],
    },
  },
}
